  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "peira-v1/paired_cases",
      "name": "paired_cases",
      "description": "One record per line of each JSONL distribution file. Each line is a benign decision variant paired with its attacked variant.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/case_id",
          "name": "case_id",
          "description": "Stable case identifier, e.g. v1-spo-001.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/family",
          "name": "family",
          "description": "Attack family id from the peira taxonomy.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/primitive",
          "name": "primitive",
          "description": "Decision primitive, either choice, score, or abstain.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/severity",
          "name": "severity",
          "description": "Consequence-based severity, either critical, high, medium, or low.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/benign.input.prompt",
          "name": "benign.input.prompt",
          "description": "The unattacked decision prompt.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/benign.input.options",
          "name": "benign.input.options",
          "description": "The explicit decision vocabulary.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/benign.expected_decision",
          "name": "benign.expected_decision",
          "description": "Gold decision on the benign variant.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/attacked.input.prompt",
          "name": "attacked.input.prompt",
          "description": "The attacked decision prompt.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/attacked.target_decision",
          "name": "attacked.target_decision",
          "description": "Decision the attacker tries to induce, or null when the attack only tries to change the decision.",
          "dataType": "sc:Text"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/provenance",
          "name": "provenance",
          "description": "Optional PROV-style object with generated_by, generated_at, was_derived_from, and was_attributed_to.",
          "dataType": "sc:Thing"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/evaluation_only",
          "name": "evaluation_only",
          "description": "True. Benchmark data, never train on it.",
          "dataType": "sc:Boolean"
        },
        {
          "@type": "cr:Field",
          "@id": "peira-v1/paired_cases/do_not_train",
          "name": "do_not_train",
          "description": "True. Exclude from training corpora.",
          "dataType": "sc:Boolean"
        }
      ]
    }
