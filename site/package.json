{
  "dependencies": {
    "astro": "^5.13.0"
  },
  "name": "peira-site",
  "private": true,
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "gen-mock": "python3 scripts/gen_mock.py --out assets/mock-artifacts",
    "ingest": "python3 scripts/ingest.py",
    "ingest-mock": "python3 scripts/ingest.py --mock assets/mock-artifacts --out src/data/results.json",
    "prebuild": "npm run ingest-mock",
    "preview": "astro preview",
    "test": "node --test tests/site.test.js tests/site-views.test.js tests/site-methodology.test.js"
  },
  "type": "module",
  "version": "1.0.0",
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}